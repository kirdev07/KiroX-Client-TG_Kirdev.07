<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7.x launchers (no adaptive icons): the same background and logo as mipmap-anydpi-v26/ic_launcher_cosmos.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:endColor="#1B2A6B" android:startColor="#7B4CE0" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>